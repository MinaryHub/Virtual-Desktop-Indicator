<Window x:Class="DeskCue.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCue"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsHitTestVisible="False">

    <Border x:Name="Root"
            CornerRadius="10"
            Padding="14,8"
            Background="#000000"
            Opacity="0.55">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="NumberText"
                       Text="1"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="28"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="NameText"
                       Text=""
                       Margin="10,0,0,0"
                       FontFamily="Segoe UI"
                       FontWeight="Normal"
                       FontSize="16"
                       Foreground="#FFFFFF"
                       Opacity="0.85"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>

<Window x:Class="VirtualDesktopIndicator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="가상 데스크톱 인디케이터 - 설정"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFF7F7F9">

    <StackPanel Margin="18">

        <CheckBox x:Name="AutoStartCheck"
                  Content="Windows 시작 시 자동 실행"
                  FontSize="14"
                  Margin="0,0,0,16" />

        <TextBlock Text="단축키"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2" />
        <TextBlock Text="변경할 항목의 버튼을 클릭한 뒤 원하는 조합을 누르세요. (Esc 취소 · Delete 지우기)"
                   FontSize="11"
                   Foreground="#FF666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel x:Name="RowsPanel" />

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   Foreground="#FFB00020"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="SaveButton"
                    Content="저장"
                    Width="88" Height="30"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnSave" />
            <Button x:Name="CancelButton"
                    Content="취소"
                    Width="88" Height="30"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>

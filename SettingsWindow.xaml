<Window x:Class="VirtualDesktopIndicator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCue - Settings"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Background="#FFF4F5F7">

    <!--
      Layout: one card per group of settings on a tinted window background, with a single
      action bar at the bottom. The control x:Names and Click handlers are unchanged — the
      code-behind (including the code-built hotkey rows) binds to them by name, and those
      generated rows pick up the implicit Button/CheckBox styles below for free.
    -->
    <Window.Resources>

        <!-- Palette. Light-only on purpose: the app has no dark-mode plumbing, and a settings
             window that follows the system theme while the overlay does not would look broken. -->
        <!-- The window background is set as a literal on the Window element above: a
             StaticResource there would be resolved before this dictionary exists. -->
        <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BorderBrush2"    Color="#FFE2E4E9" />
        <SolidColorBrush x:Key="TextBrush"       Color="#FF1F2328" />
        <SolidColorBrush x:Key="MutedBrush"      Color="#FF6B7280" />
        <SolidColorBrush x:Key="AccentBrush"     Color="#FF0F6CBD" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF115EA3" />
        <SolidColorBrush x:Key="AccentPressBrush" Color="#FF0C4E85" />
        <SolidColorBrush x:Key="DangerBrush"     Color="#FFB00020" />
        <SolidColorBrush x:Key="HeartBrush"      Color="#FFD1436A" />

        <!-- Section label above each card ("GENERAL", "DISPLAY", …). -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0,0,0" />
        </Style>

        <!-- Default (secondary) button: flat, rounded, hover/press feedback. Also applies to the
             per-row "Clear" buttons created in BuildRows(). -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="#FFD5D8DE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF3F4F6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFC2C6CD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE9EBEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Key picker. Only the chrome is restyled (the stock template still ships the Aero
             gradient, which is the one dated surface left next to the flat buttons); the
             ComboBox's own selection/keyboard behaviour is untouched. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF0F1F4" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFE7F1FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="#FFD5D8DE" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M 0,0 L 4,4 L 8,0"
                                                  Stroke="#FF5B6270"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#FFF3F4F6" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFC2C6CD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              Margin="10,0,24,0" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="#FFD5D8DE"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0"
                                        Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action (Save). Same template, accent fill. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Two rows: the settings scroll, the action bar stays put. With nine hotkey rows the
         window is tall enough to run off a small or high-DPI screen, and MaxHeight (set in the
         code-behind from the work area) would otherwise clip the Save button away. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,18,20,4">
            <StackPanel>

        <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="AutoStartCheck" Content="Run at Windows startup" />
                <TextBlock Text="Launches automatically at logon. Per-user, no admin rights needed."
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="24,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="MultiMonitorCheck"
                          Content="Show on all monitors (same position on each)"
                          Margin="0,0,0,10" />

                <CheckBox x:Name="SmoothSwitchCheck"
                          Content="Animate desktop switch (prevents taskbar flicker)"
                          Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Opacity"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Slider x:Name="OpacitySlider"
                            Grid.Column="1"
                            Minimum="5" Maximum="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="OpacityValueText"
                               Grid.Column="2"
                               Text="50%"
                               FontSize="13"
                               Width="42"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="HOTKEYS" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Check the modifiers (Win · Ctrl · Shift · Alt) and pick a key. At least one modifier is required."
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <!-- Rows are added by BuildRows() in the code-behind, one per desktop. -->
                <StackPanel x:Name="RowsPanel" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="2,0,0,10"
                   Visibility="Collapsed" />

            </StackPanel>
        </ScrollViewer>

        <!-- Action bar: version on the left, actions on the right, primary action last. -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="VersionText"
                       Grid.Column="0"
                       Text="Version"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- Opens the GitHub Sponsors page in the browser; the app handles no payment. -->
                <Button x:Name="DonateButton"
                        Margin="0,0,8,0"
                        ToolTip="Open the GitHub Sponsors page in your browser"
                        Click="OnDonate">
                    <TextBlock>
                        <Run Text="&#x2665;" Foreground="{StaticResource HeartBrush}" />
                        <Run Text=" Support" />
                    </TextBlock>
                </Button>

                <Button x:Name="UpdateButton"
                        Content="Check for updates"
                        Margin="0,0,8,0"
                        Click="OnCheckUpdate" />

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="84"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnCancel" />

                <Button x:Name="SaveButton"
                        Content="Save"
                        Width="84"
                        Style="{StaticResource AccentButton}"
                        IsDefault="True"
                        Click="OnSave" />
            </StackPanel>
        </Grid>
        </Border>
    </Grid>
</Window>

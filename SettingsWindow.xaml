<Window x:Class="VirtualDesktopIndicator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Desktop Indicator - Settings"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#FFF7F7F9">

    <StackPanel Margin="18">

        <CheckBox x:Name="AutoStartCheck"
                  Content="Run at Windows startup"
                  FontSize="14"
                  Margin="0,0,0,16" />

        <TextBlock Text="Hotkeys"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2" />
        <TextBlock Text="Check the modifiers (Win · Ctrl · Shift · Alt) and pick a key. At least one modifier is required."
                   FontSize="11"
                   Foreground="#FF666666"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel x:Name="RowsPanel" />

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   Foreground="#FFB00020"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="88" Height="30"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnSave" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="88" Height="30"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>

        <Separator Margin="0,16,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="VersionText"
                       Grid.Column="0"
                       Text="Version"
                       FontSize="12"
                       Foreground="#FF777777"
                       VerticalAlignment="Center" />

            <Button x:Name="UpdateButton"
                    Grid.Column="1"
                    Content="Check for updates"
                    Width="130" Height="28"
                    FontSize="12"
                    Click="OnCheckUpdate" />
        </Grid>
    </StackPanel>
</Window>

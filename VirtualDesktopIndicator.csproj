<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-10 SDK TFM (not bare net9.0-windows) so the WinRT projections for the MSIX
         StartupTask API are available; 19041 = Windows 10 2004, our minimum packaged target. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>VirtualDesktopIndicator</AssemblyName>
    <RootNamespace>VirtualDesktopIndicator</RootNamespace>

    <!-- Release version: bump these by hand for a meaningful release.
         The 4th (build) component is stamped automatically on every build
         by the StampBuildVersion target below (see build.counter).
         CI passes an explicit -p:Version=<tag> and -p:SkipVersionStamp=true
         so release builds carry the exact tag version instead of a local counter. -->
    <VersionPrefix>1.3.3</VersionPrefix>

    <!-- DPI is configured via app.manifest (WPF-primary app); silence the WinForms-specific hint. -->
    <NoWarn>WFO0003</NoWarn>
    <!-- Publish as a single self-contained exe with: dotnet publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Keep the SDK's default globbing from scanning into linux/ below. -->
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <!-- The Linux/X11 build lives in linux/ as its own project; exclude it from the
       Windows project's implicit **/* globs so its sources/obj aren't compiled here. -->
  <ItemGroup>
    <Compile Remove="linux/**/*.cs" />
    <Page Remove="linux/**/*.xaml" />
    <None Remove="linux/**" />
    <EmbeddedResource Remove="linux/**" />
  </ItemGroup>

  <!--
    Auto-increment the build number on every build.
    build.counter holds a single integer that is bumped and written back each
    build; the app version becomes <VersionPrefix>.<counter> (e.g. 1.0.0.42).
    Runs before GenerateAssemblyInfo so the stamped version lands in the
    generated AssemblyInfo (FileVersion / InformationalVersion / AssemblyVersion).
    build.counter is git-ignored, so it is a per-machine local counter.
  -->
  <Target Name="StampBuildVersion"
          Condition="'$(SkipVersionStamp)' != 'true'"
          BeforeTargets="GenerateAssemblyInfo;GetAssemblyVersion;CoreCompile">
    <PropertyGroup>
      <BuildCounterFile>$(MSBuildProjectDirectory)\build.counter</BuildCounterFile>
    </PropertyGroup>

    <ReadLinesFromFile File="$(BuildCounterFile)" Condition="Exists('$(BuildCounterFile)')">
      <Output TaskParameter="Lines" PropertyName="_PrevBuildCounter" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_PrevBuildCounter Condition="'$(_PrevBuildCounter)' == ''">0</_PrevBuildCounter>
      <_NextBuildCounter>$([MSBuild]::Add($(_PrevBuildCounter), 1))</_NextBuildCounter>
    </PropertyGroup>

    <WriteLinesToFile File="$(BuildCounterFile)" Lines="$(_NextBuildCounter)" Overwrite="true" />

    <PropertyGroup>
      <Version>$(VersionPrefix).$(_NextBuildCounter)</Version>
      <AssemblyVersion>$(VersionPrefix).$(_NextBuildCounter)</AssemblyVersion>
      <FileVersion>$(VersionPrefix).$(_NextBuildCounter)</FileVersion>
      <InformationalVersion>$(VersionPrefix).$(_NextBuildCounter)</InformationalVersion>
    </PropertyGroup>

    <Message Importance="high" Text="Stamped version $(Version)" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>VirtualDesktopIndicator</AssemblyName>
    <RootNamespace>VirtualDesktopIndicator</RootNamespace>
    <Version>1.0.0</Version>
    <!-- DPI is configured via app.manifest (WPF-primary app); silence the WinForms-specific hint. -->
    <NoWarn>WFO0003</NoWarn>
    <!-- Publish as a single self-contained exe with: dotnet publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>

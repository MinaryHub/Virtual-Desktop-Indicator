<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VirtualDesktopIndicator.Linux.SettingsWindow"
        Title="Virtual Desktop Indicator - Settings"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="18">

        <CheckBox x:Name="AutoStartCheck"
                  Content="Run at login"
                  FontSize="14"
                  Margin="0,0,0,16" />

        <TextBlock Text="Hotkeys"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,2" />
        <TextBlock Text="Check the modifiers (Super · Ctrl · Shift · Alt) and pick a key. At least one modifier is required."
                   FontSize="11"
                   Foreground="#888888"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel x:Name="RowsPanel" />

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   IsVisible="False" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="90" IsDefault="True" Click="OnSave" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" IsCancel="True" Click="OnCancel" />
        </StackPanel>

        <Border Height="1" Background="#22000000" Margin="0,16,0,10" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="VersionText"
                       Grid.Column="0"
                       Text="Version"
                       FontSize="12"
                       Foreground="#888888"
                       VerticalAlignment="Center" />
            <Button x:Name="UpdateButton"
                    Grid.Column="1"
                    Content="Check for updates"
                    FontSize="12"
                    Click="OnCheckUpdate" />
        </Grid>
    </StackPanel>
</Window>

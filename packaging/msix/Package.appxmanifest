<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store / sideloaded build.

  Packaged as a full-trust Win32 desktop app (EntryPoint=Windows.FullTrustApplication):
  SendInput, RegisterHotKey and the registry reads all keep working exactly as in the
  plain-exe build. The only packaged-specific behaviour lives behind PackageContext:
  self-update is disabled and "run at startup" uses the windows.startupTask below.

  Identity below matches Partner Center ▸ Product ▸ Product identity. Publisher is the
  account's publisher GUID and PublisherDisplayName the account name — both account-wide,
  the same in every product; Identity/@Name is reserved per product, and
  Properties/DisplayName must be one of that product's reserved names. The Store rejects
  the upload naming the exact expected value if any of them differs, so change them only
  against that page (do NOT paste values from another product).
  build-msix.ps1 refuses to pack if a PLACEHOLDER ever reappears (-AllowPlaceholders
  overrides it for local sideload testing only).
  The Store re-signs the package on ingestion, so no code-signing certificate is needed
  for Store distribution. Identity/@Version must be 4-part with revision 0 (CI stamps it).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!-- Name is the identity of the *DeskCue* product reservation. It is not minary.Curvo:
       that is a different product in the same account, and uploading this package there is
       what produced the "Invalid package identity name (expected: minary.Curvo)" rejection.
       Properties/DisplayName below must stay a name reserved for the DeskCue product. -->
  <Identity
    Name="minary.DeskCue"
    Publisher="CN=C460CD23-2642-4BA2-A332-6F8ADBE54E1F"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeskCue</DisplayName>
    <PublisherDisplayName>minary</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The app UI is English-only (no localized resources / resources.pri ships in the
       package), so declare just en-us. Declaring a language the package has no resources
       for makes the Store list a language the app does not actually offer. -->
  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DeskCue"
                 Executable="DeskCue.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeskCue"
        Description="Always-on-top indicator showing the current Windows virtual desktop, with hotkeys to jump to any desktop."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>

      <Extensions>
        <!-- "Run at Windows startup". Ships disabled; the app requests enable via the
             StartupTask API (StartupManager), and the user can override in Task Manager.
             TaskId must equal StartupManager.TaskId. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask
            TaskId="DeskCueStartup"
            Enabled="false"
            DisplayName="DeskCue" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full-trust Win32 app: needed for SendInput key synthesis, global hotkeys and
         the virtual-desktop registry reads. This is the standard capability for a
         Desktop-Bridge packaged app and is allowed for Store submission. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
